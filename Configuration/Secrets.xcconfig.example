// Copy this file to Secrets.xcconfig and fill in the real values.
//
//     cp Configuration/Secrets.xcconfig.example Configuration/Secrets.xcconfig
//
// Secrets.xcconfig is git-ignored. Debug.xcconfig and Release.xcconfig pull it
// in with `#include?`, so values here override the committed defaults.
//
// NOTE: `//` starts a comment in xcconfig files, so URLs must be escaped:
//     https:/$()/example.com/path

// Apple Developer team ID (Membership page in the Developer portal).
LANIER_DEVELOPMENT_TEAM = ABCDE12345

// One of: proxy | reso | idxbroker | simplyrets | mock
IDX_PROVIDER = mock

// --- proxy -------------------------------------------------------------
// IDX_PROVIDER = proxy
// IDX_BASE_URL = https:/$()/lanierproperties.net/wp-json/lanier-idx/v1
// IDX_API_KEY  = shared-token-if-your-endpoint-requires-one

// --- RESO Web API ------------------------------------------------------
// IDX_PROVIDER                = reso
// IDX_BASE_URL                = https:/$()/api.bridgedataoutput.com/api/v2/OData/dataset
// IDX_API_KEY                 = bearer-token
// IDX_ORIGINATING_SYSTEM_NAME = MemphisTN
// IDX_OFFICE_KEY              = your-mls-office-key

// --- IDX Broker --------------------------------------------------------
// IDX_PROVIDER                = idxbroker
// IDX_API_KEY                 = partners-api-access-key
// IDX_ORIGINATING_SYSTEM_NAME = a001

// --- SimplyRETS --------------------------------------------------------
// IDX_PROVIDER = simplyrets
// IDX_API_KEY  = apiKey:apiSecret
